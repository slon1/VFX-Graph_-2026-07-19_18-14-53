// G2P gradient: SampleGradient.
// Texture slot: FieldRead = Texture2D<float> (single-field-per-kernel; Scalar .r).
// Separate from FieldPasses.compute (float2 FieldRead) to avoid typed-bind UB.

#pragma kernel SampleGradient

#include "Assets/Shaders/GPU/Includes/FieldSampling.hlsl"

#define PARTICLE_THREADS 64

Texture2D<float> FieldRead;
SamplerState sampler_linear_clamp;

StructuredBuffer<float3> position;
RWStructuredBuffer<float3> velocity;
uint ParticleCount;
float SampleStrength;
float DeltaTime;

[numthreads(PARTICLE_THREADS, 1, 1)]
void SampleGradient(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float2 uv = WorldToFieldUV(position[id.x]);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
    {
        return;
    }

    float2 dx = float2(FieldTexelSize.x, 0.0);
    float2 dy = float2(0.0, FieldTexelSize.y);

    float right = FieldRead.SampleLevel(sampler_linear_clamp, saturate(uv + dx), 0);
    float left = FieldRead.SampleLevel(sampler_linear_clamp, saturate(uv - dx), 0);
    float up = FieldRead.SampleLevel(sampler_linear_clamp, saturate(uv + dy), 0);
    float down = FieldRead.SampleLevel(sampler_linear_clamp, saturate(uv - dy), 0);

    float2 gradUv = float2(
        (right - left) / max(2.0 * FieldTexelSize.x, 1e-5),
        (up - down) / max(2.0 * FieldTexelSize.y, 1e-5));

    float3 direction = FieldUvGradientToWorld(gradUv);
    velocity[id.x] += direction * SampleStrength * DeltaTime;
}
