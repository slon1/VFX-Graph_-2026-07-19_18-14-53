// Dynamics passes: integration, limits and collisions.
// Buffer names match attribute names — bound automatically by ParticleKernelPass.

#pragma kernel Integrate
#pragma kernel ClearVelocity
#pragma kernel HeadingSteer
#pragma kernel SpeedLimit
#pragma kernel PlaneCollider
#pragma kernel SphereCollider
#pragma kernel BoxBounds

#define THREADS 64

RWStructuredBuffer<float3> position;
RWStructuredBuffer<float3> velocity;
RWStructuredBuffer<float3> heading;
uint ParticleCount;
float DeltaTime;

float TurnSpeed;
float CruiseSpeed;

float MaxSpeed;

float3 PlanePoint;
float3 PlaneNormal;
float PlaneBounce;
float PlaneFriction;

float3 SphereCenter;
float SphereRadius;
float SphereBounce;
float SphereFriction;

float3 BoundsCenter;
float3 BoundsExtents;
float BoundsBounce;
int BoundsMode; // 0 = bounce, 1 = wrap

float3 ReflectVelocity(float3 v, float3 n, float bounce, float friction)
{
    float vn = dot(v, n);
    float3 tangential = v - n * vn;
    return tangential * (1.0 - friction) - n * (vn * bounce);
}

bool TinyOrNan(float len)
{
    return isnan(len) || !(len > 1e-6);
}

[numthreads(THREADS, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    position[id.x] += velocity[id.x] * DeltaTime;
}

[numthreads(THREADS, 1, 1)]
void ClearVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    velocity[id.x] = 0;
}

[numthreads(THREADS, 1, 1)]
void HeadingSteer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float3 force = velocity[id.x];
    float3 h = heading[id.x];
    float forceLen = length(force);
    float hLen = length(h);

    // TinyOrNan: !(len > eps) so IEEE NaN takes the safe branch, plus isnan
    // because compute fast-math can make NaN > x true. Heading lives across
    // frames — must recover from an already-infected buffer, not only avoid
    // creating NaN on this dispatch.
    float3 desired = TinyOrNan(forceLen)
        ? (TinyOrNan(hLen) ? float3(1, 0, 0) : h / hLen)
        : (force / forceLen);

    h = TinyOrNan(hLen) ? desired : (h / hLen);

    float k = saturate(TurnSpeed * DeltaTime);
    float3 blended = lerp(h, desired, k);
    float blendedLen = length(blended);
    h = TinyOrNan(blendedLen) ? desired : (blended / blendedLen);
    h.y = 0.0;
    float flat = length(h);
    h = TinyOrNan(flat) ? float3(1, 0, 0) : (h / flat);

    heading[id.x] = h;
    velocity[id.x] = h * CruiseSpeed;
}

[numthreads(THREADS, 1, 1)]
void SpeedLimit(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float3 v = velocity[id.x];
    float speed = length(v);

    if (speed > MaxSpeed && speed > 1e-6)
    {
        velocity[id.x] = v * (MaxSpeed / speed);
    }
}

[numthreads(THREADS, 1, 1)]
void PlaneCollider(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float3 n = normalize(PlaneNormal);
    float3 p = position[id.x];
    float depth = dot(p - PlanePoint, n);

    if (depth < 0.0)
    {
        position[id.x] = p - n * depth;

        float3 v = velocity[id.x];
        if (dot(v, n) < 0.0)
        {
            velocity[id.x] = ReflectVelocity(v, n, PlaneBounce, PlaneFriction);
        }
    }
}

[numthreads(THREADS, 1, 1)]
void SphereCollider(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float3 offset = position[id.x] - SphereCenter;
    float dist = length(offset);

    if (dist < SphereRadius && dist > 1e-6)
    {
        float3 n = offset / dist;
        position[id.x] = SphereCenter + n * SphereRadius;

        float3 v = velocity[id.x];
        if (dot(v, n) < 0.0)
        {
            velocity[id.x] = ReflectVelocity(v, n, SphereBounce, SphereFriction);
        }
    }
}

[numthreads(THREADS, 1, 1)]
void BoxBounds(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    float3 p = position[id.x];
    float3 minCorner = BoundsCenter - BoundsExtents;
    float3 maxCorner = BoundsCenter + BoundsExtents;

    if (BoundsMode == 1)
    {
        // Wrap: torus topology.
        float3 size = BoundsExtents * 2.0;
        float3 local = p - minCorner;
        float3 wrapped = local - size * floor(local / size);
        // Per-axis select: a zero extent (2D plane, extents.y = 0) must not wrap.
        // max(size, eps) would wrap into an infinitely thin cell. Bounce with
        // extents.y = 0 still clamps p.y to center — out of scope (F0.4).
        local = (size > 1e-6) ? wrapped : local;
        position[id.x] = local + minCorner;
        return;
    }

    // Bounce.
    float3 v = velocity[id.x];

    [unroll]
    for (int axis = 0; axis < 3; axis++)
    {
        if (p[axis] < minCorner[axis])
        {
            p[axis] = minCorner[axis];
            v[axis] = abs(v[axis]) * BoundsBounce;
        }
        else if (p[axis] > maxCorner[axis])
        {
            p[axis] = maxCorner[axis];
            v[axis] = -abs(v[axis]) * BoundsBounce;
        }
    }

    position[id.x] = p;
    velocity[id.x] = v;
}
