#pragma kernel CSMain

#include "Assets/Shaders/GPU/Operators/Operator.hlsl"

RWStructuredBuffer<float3> Positions;
uint ParticleCount;

[numthreads(256, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= ParticleCount)
    {
        return;
    }

    Positions[id.x] = ApplyOperator(Positions[id.x]);
}
